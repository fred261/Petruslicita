{
  "name": "petrus-licitacao",
  "private": true,
  "version": "0.1.0",
  "description": "Petrus Licitação — Sistema de Gestão de Licitações",
  "scripts": {
    "build:shared": "pnpm --filter @petrus/shared build",
    "dev:api": "pnpm build:shared && pnpm --filter @petrus/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @petrus/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @petrus/api prisma:generate",
    "prisma:migrate": "pnpm --filter @petrus/api prisma:migrate",
    "prisma:studio": "pnpm --filter @petrus/api prisma:studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
