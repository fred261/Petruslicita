# --- Banco de dados ---
DATABASE_URL="postgresql://petrus:petrus@localhost:5432/petrus_licitacao?schema=public"

# --- Redis (filas / cobranças agendadas) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-acesso"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
TOTP_ISSUER="Petrus Licitação"

# --- Política de segurança ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Storage de documentos ---
# Sem MinIO rodando (docker-compose up)? Deixe S3_BUCKET em branco para usar
# o disco local automaticamente — útil para rodar a API sem depender do Docker.
STORAGE_LOCAL_DIR="./storage/documentos"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="petrus-documentos"
S3_ACCESS_KEY="petrus"
S3_SECRET_KEY="petrus12345"
S3_FORCE_PATH_STYLE="true"

# --- Consulta de CNPJ ---
CNPJ_LOOKUP_PRIMARY_URL="https://brasilapi.com.br/api/cnpj/v1"
CNPJ_LOOKUP_FALLBACK_URL="https://publica.cnpj.ws/cnpj"

# --- Captação de editais (PNCP) ---
PNCP_BASE_URL="https://pncp.gov.br/api/consulta"

# --- E-mail (notificações) ---
EMAIL_FROM="nao-responda@petruslicitacao.com.br"
RESEND_API_KEY=""

# --- App ---
API_PORT=3333
WEB_URL="http://localhost:5173"
