generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis de acesso — EMPRESA já existe no modelo mas sem telas ativas ainda.
enum Papel {
  MASTER
  ADMIN
  OPERADOR
  EMPRESA
}

enum StatusCliente {
  ATIVO
  INATIVO
}

enum AcaoAuditoria {
  CREATE
  UPDATE
  DELETE
}

/// Identifica o adaptador de portal que originou a licitação — hoje só PNCP,
/// desenhado para plugar futuros portais municipais/estaduais.
enum FonteLicitacao {
  PNCP
  MANUAL
}

enum OrigemItem {
  AUTO_IMPORTADO
  MANUAL
}

enum OrigemParticipacao {
  SUGESTAO_MATCHING
  MANUAL
}

enum MotivoPerdaCategoria {
  PRECO_SUPERIOR
  DESCLASSIFICACAO_TECNICA
  INABILITACAO_DOCUMENTAL
  DESISTENCIA_PROPRIA
  REVOGACAO_ANULACAO
  OUTRO
}

/// Fluxo de status da Participação (spec: "Fluxo de Status da Participação").
enum StatusParticipacao {
  SUGERIDA
  EM_ANALISE
  DESCARTADA
  EM_PREPARACAO
  ENVIADA
  EM_DISPUTA
  HABILITACAO
  RECURSAL
  VENCEDORA
  NAO_VENCEDORA
  HOMOLOGADA
  CONTRATADA
}

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String
  papel     Papel
  ativo     Boolean @default(true)

  // Segurança / login
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  ultimoAcessoEm   DateTime?

  clientes            UsuarioCliente[]
  refreshTokens       RefreshToken[]
  accessLogs          AccessLog[]
  auditLogs           AuditLog[]
  clientesResponsavel Cliente[]        @relation("ClienteResponsavel")
  participacoes       Participacao[]   @relation("ParticipacaoResponsavel")
  eventos             Evento[]
  comentarios         Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

/// Vínculo Usuário x Cliente — usado para escopo de Operador e (futuramente) Empresa.
model UsuarioCliente {
  id        String   @id @default(cuid())
  usuarioId String
  clienteId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, clienteId])
  @@map("usuarios_clientes")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  @@map("refresh_tokens")
}

model AccessLog {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  email     String
  ip        String?
  userAgent String?
  sucesso   Boolean
  motivo    String?
  criadoEm  DateTime @default(now())

  @@map("access_logs")
}

/// Log de auditoria por alteração em entidades sensíveis (quem, o quê, quando).
model AuditLog {
  id          String        @id @default(cuid())
  usuarioId   String?
  usuario     Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  entidade    String
  entidadeId  String
  acao        AcaoAuditoria
  dadosAntes  Json?
  dadosDepois Json?
  criadoEm    DateTime      @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

/// Empresa-cliente do escritório (tenant lógico). O CNAE e dados cadastrais
/// nascem uma única vez, via consulta de CNPJ, e ficam travados para edição direta.
model Cliente {
  id String @id @default(cuid())

  // --- Bloco travado (somente via consulta de CNPJ) ---
  cnpj                   String   @unique
  razaoSocial            String
  nomeFantasia           String?
  cnaePrincipalCodigo    String
  cnaePrincipalDescricao String
  cnaesSecundarios       Json     @default("[]")
  situacaoCadastral      String
  enderecoLogradouro     String?
  enderecoNumero         String?
  enderecoComplemento    String?
  enderecoBairro         String?
  enderecoMunicipio      String?
  enderecoUf             String?
  enderecoCep            String?
  dadosApiAtualizadosEm  DateTime

  // --- Camada complementar editável ---
  palavrasChave        Json          @default("[]")
  ufsInteresse         String[]      @default([])
  valorMinimoInteresse Decimal?      @db.Decimal(14, 2)
  valorMaximoInteresse Decimal?      @db.Decimal(14, 2)
  responsavelId        String?
  responsavel          Usuario?      @relation("ClienteResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  status               StatusCliente @default(ATIVO)

  usuarios      UsuarioCliente[]
  participacoes Participacao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("clientes")
}

/// Licitação/edital — entidade global compartilhada entre clientes, nunca
/// duplicada por cliente. Uma mesma licitação pode ter várias Participações,
/// uma por cliente concorrente nela.
model Licitacao {
  id String @id @default(cuid())

  fonte                    FonteLicitacao
  idExterno                String?
  orgaoCnpj                String
  orgaoNome                String
  esfera                   String?
  numeroProcesso           String
  modalidadeCodigo         String?
  modalidadeNome           String
  objeto                   String
  valorEstimado            Decimal?       @db.Decimal(16, 2)
  uf                       String
  municipio                String?
  dataPublicacao           DateTime?
  dataLimiteImpugnacao     DateTime?
  dataLimiteEsclarecimento DateTime?
  dataSessaoAbertura       DateTime?
  linkEdital               String?
  situacao                 String?

  /// Marca quando os itens/lotes foram buscados pela última vez — a listagem
  /// geral do PNCP não traz itens embutidos, então só disparamos a chamada de
  /// detalhe quando a licitação recebe sugestão/participação (evita volume
  /// desnecessário de chamadas).
  itensCaptadosEm DateTime?

  itens         Item[]
  participacoes Participacao[]
  eventos       Evento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([fonte, numeroProcesso, orgaoCnpj])
  @@index([uf])
  @@index([fonte, idExterno])
  @@map("licitacoes")
}

/// Item/lote de uma licitação (subset dos quais uma Participação disputa).
model Item {
  id          String    @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  numero                Int
  descricao             String
  unidadeMedida         String?
  quantidade            Decimal    @db.Decimal(14, 3)
  valorUnitarioEstimado Decimal?   @db.Decimal(16, 4)
  valorTotalEstimado    Decimal?   @db.Decimal(16, 2)
  /// Situação bruta conforme domínio do PNCP (aberto, cancelado, deserto,
  /// fracassado, homologado...), armazenada como texto por variar por fonte.
  situacao              String?
  origem                OrigemItem @default(AUTO_IMPORTADO)

  participacoes ParticipacaoItem[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([licitacaoId, numero])
  @@map("itens")
}

/// Cliente x Licitação — núcleo do pipeline. Criada apenas por ação humana
/// ("Criar Participação"), nunca automaticamente pelo motor de matching.
/// A tela completa de gestão do pipeline (prazos, cobrança, mudança de
/// status) é entregue no módulo de Pipeline de Participação.
model Participacao {
  id String @id @default(cuid())

  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  status        StatusParticipacao @default(SUGERIDA)
  origem        OrigemParticipacao
  responsavelId String?
  responsavel   Usuario?           @relation("ParticipacaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  observacoes   String?

  /// Dispara a cobrança automática de atualização (motor de prazos).
  proximoPrazo  DateTime?
  valorProposto Decimal?  @db.Decimal(16, 2)
  dataDecisao   DateTime?

  // --- Motivo de perda (estruturado — vira estatística) ---
  motivoPerdaCategoria         MotivoPerdaCategoria?
  motivoPerdaTexto             String?
  concorrenteVencedorNome      String?
  concorrenteVencedorCnpj      String?
  valorPropostaVencedora       Decimal?              @db.Decimal(16, 2)
  /// (propostaVencedora - valorProposto) / valorProposto * 100 — calculado no servidor.
  diferencaPercentualVencedora Decimal?              @db.Decimal(7, 2)

  itens       ParticipacaoItem[]
  eventos     Evento[]
  comentarios Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, licitacaoId])
  @@index([proximoPrazo])
  @@map("participacoes")
}

/// Subset dos Itens da Licitação que a Participação está disputando.
model ParticipacaoItem {
  id             String       @id @default(cuid())
  participacaoId String
  participacao   Participacao @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  criadoEm       DateTime     @default(now())

  @@unique([participacaoId, itemId])
  @@map("participacao_itens")
}

/// Colaboração interna — anotações visíveis apenas à equipe do escritório,
/// nunca ao perfil Empresa.
model Comentario {
  id             String       @id @default(cuid())
  participacaoId String
  participacao   Participacao @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
  autorId        String?
  autor          Usuario?     @relation(fields: [autorId], references: [id], onDelete: SetNull)
  texto          String
  criadoEm       DateTime     @default(now())

  @@index([participacaoId])
  @@map("comentarios")
}

/// Histórico imutável de eventos — vinculado a Licitação e/ou Participação.
model Evento {
  id String @id @default(cuid())

  tipo      String
  descricao String
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  anexoUrl  String?

  licitacaoId    String?
  licitacao      Licitacao?    @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  participacaoId String?
  participacao   Participacao? @relation(fields: [participacaoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([licitacaoId])
  @@index([participacaoId])
  @@map("eventos")
}
