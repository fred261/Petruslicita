generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis de acesso — EMPRESA já existe no modelo mas sem telas ativas ainda.
enum Papel {
  MASTER
  ADMIN
  OPERADOR
  EMPRESA
}

enum StatusCliente {
  ATIVO
  INATIVO
}

enum AcaoAuditoria {
  CREATE
  UPDATE
  DELETE
}

model Usuario {
  id                  String   @id @default(cuid())
  nome                String
  email               String   @unique
  senhaHash           String
  papel               Papel
  ativo               Boolean  @default(true)

  // Segurança / login
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  tentativasFalhas     Int      @default(0)
  bloqueadoAte         DateTime?
  ultimoAcessoEm       DateTime?

  clientes            UsuarioCliente[]
  refreshTokens       RefreshToken[]
  accessLogs          AccessLog[]
  auditLogs           AuditLog[]
  clientesResponsavel Cliente[] @relation("ClienteResponsavel")

  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  @@map("usuarios")
}

/// Vínculo Usuário x Cliente — usado para escopo de Operador e (futuramente) Empresa.
model UsuarioCliente {
  id         String   @id @default(cuid())
  usuarioId  String
  clienteId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  criadoEm   DateTime @default(now())

  @@unique([usuarioId, clienteId])
  @@map("usuarios_clientes")
}

model RefreshToken {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime @default(now())

  @@map("refresh_tokens")
}

model AccessLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  email      String
  ip         String?
  userAgent  String?
  sucesso    Boolean
  motivo     String?
  criadoEm   DateTime @default(now())

  @@map("access_logs")
}

/// Log de auditoria por alteração em entidades sensíveis (quem, o quê, quando).
model AuditLog {
  id           String        @id @default(cuid())
  usuarioId    String?
  usuario      Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  entidade     String
  entidadeId   String
  acao         AcaoAuditoria
  dadosAntes   Json?
  dadosDepois  Json?
  criadoEm     DateTime      @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

/// Empresa-cliente do escritório (tenant lógico). O CNAE e dados cadastrais
/// nascem uma única vez, via consulta de CNPJ, e ficam travados para edição direta.
model Cliente {
  id                     String         @id @default(cuid())

  // --- Bloco travado (somente via consulta de CNPJ) ---
  cnpj                   String         @unique
  razaoSocial            String
  nomeFantasia           String?
  cnaePrincipalCodigo    String
  cnaePrincipalDescricao String
  cnaesSecundarios       Json           @default("[]")
  situacaoCadastral      String
  enderecoLogradouro     String?
  enderecoNumero         String?
  enderecoComplemento    String?
  enderecoBairro         String?
  enderecoMunicipio      String?
  enderecoUf             String?
  enderecoCep            String?
  dadosApiAtualizadosEm  DateTime

  // --- Camada complementar editável ---
  palavrasChave          Json           @default("[]")
  ufsInteresse           String[]       @default([])
  valorMinimoInteresse   Decimal?       @db.Decimal(14, 2)
  valorMaximoInteresse   Decimal?       @db.Decimal(14, 2)
  responsavelId          String?
  responsavel            Usuario?       @relation("ClienteResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  status                 StatusCliente  @default(ATIVO)

  usuarios               UsuarioCliente[]

  criadoEm               DateTime       @default(now())
  atualizadoEm           DateTime       @updatedAt

  @@map("clientes")
}
