{
  "name": "@petrus/nfse-fortaleza",
  "private": true,
  "version": "0.1.0",
  "description": "Robô de emissão de NFS-e no portal ISS da SEFIN de Fortaleza (login, seleção de CNPJ, seleção de cliente e emissão da nota).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "commander": "^12.1.0",
    "playwright": "^1.47.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/prompts": "^2.4.9",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
