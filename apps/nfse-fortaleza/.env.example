# Banco de dados local (SQLite — arquivo na própria pasta). Para produção,
# troque o provider no prisma/schema.prisma para "postgresql" e aponte aqui.
DATABASE_URL="file:./dev.db"

# Chave mestra usada para criptografar (AES-256-GCM) as credenciais de login
# do portal SEFIN antes de salvar no banco. Gere uma só vez com:
#   openssl rand -base64 32
# Guarde em local seguro — perder essa chave impede descriptografar credenciais salvas.
NFSE_MASTER_KEY=""

# "true" força o navegador a rodar sem interface (headless). Deixe em branco/"false"
# durante os testes em modo semi-automático — você precisa ver a tela pra revisar.
NFSE_HEADLESS="false"
